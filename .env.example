# Copy to .env and fill in. Nothing here is a real secret.

# MongoDB connection string
DB_URL=mongodb://127.0.0.1:27017/venure

# Two DIFFERENT random strings — the server refuses to start if they match
JWT_SECRET=
REFRESH_TOKEN_SECRET=

PORT=5051

# Origin(s) the API accepts cookies/requests from. Comma-separate for several
# (e.g. production + a Vercel preview). Any http://localhost:<port> origin is
# always allowed outside production, so this rarely needs to include your dev port.
FRONTEND_URL=http://localhost:5180

# Payments — leave blank to disable; booking/payment routes warn instead of crashing
STRIPE_SECRET_KEY=

# Google Identity Services sign-in — leave blank to disable.
# Create at console.cloud.google.com > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application. Add your frontend
# origin(s) (e.g. http://localhost:5180) under "Authorized JavaScript origins".
# This is the public Client ID, not a secret — the frontend needs the same value
# as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email (password reset codes, notifications)
GMAIL_USER=
GMAIL_PASS=

# eSewa payment gateway (Nepal) — leave blank to disable
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
